{
    "manifest_version": 3,
    "name": "wordframe",
    "version": "1.0.0",

    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "css": ["content.css"]
        }
    ],
    "host_permissions": [
        "https://api.mymemory.translated.net/*"
    ],
    "permissions": [
        "storage"
    ],
    "commands": {
        "translate-selection": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y"
            },
            "description": "traduz o texto selecionado na página."
        },
        "toggle-recording": {
            "suggested_key": {
                "default": "Ctrl+Shift+U"
            },
            "description": "inicia/para a gravação do vídeo em reprodução na aba (o clipe é baixado como .webm)."
        }
    }
}
